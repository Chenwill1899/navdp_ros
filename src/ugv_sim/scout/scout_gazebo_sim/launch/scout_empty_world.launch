<launch>

    <arg name="robot_namespace" default="/"/>

    <!-- Load the surrounding environment into Gazebo -->
    <arg name="world_name" default="$(find scout_gazebo_sim)worlds/weston_robot_empty.world"/>
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(arg world_name)"/>
        <arg name="paused" value="false"/>
        <arg name="use_sim_time" value="true"/>
        <arg name="gui" value="true"/>
        <arg name="headless" value="false"/>
        <arg name="debug" value="false"/>
    </include>
    
    <include file="$(find scout_gazebo_sim)/launch/spawn_scout_v2.launch"></include>

    <!-- Spawn a 1x1x1 meter box obstacle 2 meters in front of the robot -->
    <node name="spawn_box_obstacle" pkg="gazebo_ros" type="spawn_model" 
          args="-file $(find scout_gazebo_sim)/models/box_obstacle.sdf -sdf -model box_obstacle -x 4.0 -y 0.0 -z 0.5" />

</launch>
